{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "larajax/amber",
    "type": "project",
    "description": "A sample Laravel application demonstrating the larajax/ui form, list and UI tools.",
    "homepage": "https://github.com/larajax/amber",
    "keywords": ["laravel", "october", "amber", "larajax", "ui", "form", "list", "widget"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "larajax/larajax": "^3.0",
        "larajax/ui": "dev-main",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=larajax-assets --ansi --force",
            "@php artisan vendor:publish --tag=larajax-ui-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --graceful --ansi"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/larajax/ui"
        },
        {
            "type": "vcs",
            "url": "https://github.com/larajax/larajax"
        },
        {
            "type": "vcs",
            "url": "https://github.com/octoberrain/contracts"
        },
        {
            "type": "vcs",
            "url": "https://github.com/octoberrain/exception"
        },
        {
            "type": "vcs",
            "url": "https://github.com/octoberrain/extension"
        },
        {
            "type": "vcs",
            "url": "https://github.com/octoberrain/html"
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
